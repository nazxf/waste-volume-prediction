# FastAPI / CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO

# ESP32 smart-bin ingest. Set this in production and put the same value in firmware API_KEY.
IOT_API_KEY=

# Frontend build. Use /api when served by the included nginx reverse proxy.
VITE_API_BASE=/api

# Optional email notification settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_RECIPIENTS=

# Optional SMS notification settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_RECIPIENTS=
